#!/bin/bash
# tgget (tgnas) 生命周期脚本：start / stop / status / sync_deps
# 飞牛 fnOS 会以 $1 传入操作名，退出码 0=成功/运行中，3=未运行，1=失败。

APP_NAME="tgget"
APP_DIR="${TRIM_APPDEST}"           # 安装后的 target 目录（含 run.py、tgget/、requirements.txt）
VENV_DIR="${TRIM_PKGVAR}/.venv"     # Python 虚拟环境（放数据目录，跨重启与升级保留）
DEPS_STAMP="${VENV_DIR}/.deps_hash" # 依赖安装成功指纹（防半成品死锁、升级自动补装）
DATA_DIR="${TRIM_PKGVAR}"           # 运行时数据（config.json、session、tgget.db）
PID_FILE="${TRIM_PKGVAR}/app.pid"
LOG_FILE="${TRIM_PKGVAR}/app.log"
PYTHON_BIN="/var/apps/python312/target/bin/python3"

# 兼容系统自带 python3（本地调试或不同 fnOS 环境）
if [ ! -x "$PYTHON_BIN" ]; then
  PYTHON_BIN="$(command -v python3 || echo /usr/bin/python3)"
fi

mkdir -p "$DATA_DIR" 2>/dev/null || true

log_msg() {
  echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "$LOG_FILE"
}

report_err() {
  log_msg "[ERROR] $1"
  if [ -n "$TRIM_TEMP_LOGFILE" ]; then
    echo "$1" > "$TRIM_TEMP_LOGFILE"
  else
    echo "$1" >&2
  fi
}

# 日志轮转：超过 10MB 时保留最后 2000 行，避免长期运行撑满数据目录
rotate_log() {
  if [ -f "$LOG_FILE" ]; then
    local sz
    sz="$(wc -c < "$LOG_FILE" 2>/dev/null | tr -d '[:space:]')"
    if [ -n "$sz" ] && [ "$sz" -gt 10485760 ] 2>/dev/null; then
      tail -n 2000 "$LOG_FILE" > "${LOG_FILE}.tmp" 2>/dev/null && mv "${LOG_FILE}.tmp" "$LOG_FILE"
      log_msg "日志已超过 10MB，自动轮转截断。"
    fi
  fi
}

# 计算 requirements.txt 指纹
calc_req_hash() {
  if [ -f "${APP_DIR}/requirements.txt" ]; then
    sha256sum "${APP_DIR}/requirements.txt" 2>/dev/null | awk '{print $1}'
  else
    echo "none"
  fi
}

# 准备虚拟环境：用 requirements.txt 指纹校验，支持国内清华镜像自动回退
ensure_venv() {
  local req_hash cur_hash
  req_hash="$(calc_req_hash)"
  cur_hash=""
  [ -f "$DEPS_STAMP" ] && cur_hash="$(cat "$DEPS_STAMP" 2>/dev/null | tr -d '[:space:]')"

  if [ ! -x "${VENV_DIR}/bin/python" ]; then
    log_msg "创建 Python 虚拟环境：${VENV_DIR}"
    "${PYTHON_BIN}" -m venv "${VENV_DIR}" >> "$LOG_FILE" 2>&1 || {
      report_err "无法创建 Python 虚拟环境（请确认飞牛应用中心已安装 Python 3.12）。"
      return 1
    }
    cur_hash=""
  fi

  if [ "$req_hash" != "$cur_hash" ] || ! "${VENV_DIR}/bin/python" -c "import telethon" >/dev/null 2>&1; then
    log_msg "正在安装/更新 Python 依赖（requirements 指纹：${req_hash}）..."
    if ! "${VENV_DIR}/bin/pip" install --no-cache-dir -r "${APP_DIR}/requirements.txt" >> "$LOG_FILE" 2>&1; then
      log_msg "默认 PyPI 源安装失败，自动切换清华镜像源重试..."
      "${VENV_DIR}/bin/pip" install --no-cache-dir \
        -i https://pypi.tuna.tsinghua.edu.cn/simple \
        --trusted-host pypi.tuna.tsinghua.edu.cn \
        -r "${APP_DIR}/requirements.txt" >> "$LOG_FILE" 2>&1 || {
        report_err "依赖安装失败，请检查 NAS 网络连接后重试。"
        return 1
      }
    fi
    echo "$req_hash" > "$DEPS_STAMP"
    log_msg "虚拟环境与依赖就绪。"
  fi
  return 0
}

# 将飞牛向导（wizard_*）中非空的字段合并写入 config.json，绝不覆盖用户在网页端已自定义的保存目录等配置
sync_wizard_to_config() {
  if [ -z "$wizard_api_id" ] && [ -z "$wizard_api_hash" ] && [ -z "$wizard_token" ] && [ -z "$wizard_proxy" ]; then
    return 0
  fi
  "${VENV_DIR}/bin/python" - "$DATA_DIR/config.json" <<'PYEOF' >> "$LOG_FILE" 2>&1 || true
import json, os, sys
from pathlib import Path

cfg_path = Path(sys.argv[1])
data = {}
if cfg_path.exists():
    try:
        data = json.loads(cfg_path.read_text(encoding="utf-8"))
    except Exception:
        data = {}

changed = False
api_id = os.environ.get("wizard_api_id", "").strip()
if api_id.isdigit() and int(api_id) > 0:
    data["api_id"] = int(api_id)
    changed = True

api_hash = os.environ.get("wizard_api_hash", "").strip()
if api_hash:
    data["api_hash"] = api_hash
    changed = True

token = os.environ.get("wizard_token", "").strip()
if token:
    data["token"] = token
    changed = True

proxy = os.environ.get("wizard_proxy", "").strip()
if proxy:
    data["proxy"] = proxy
    changed = True

if changed:
    cfg_path.parent.mkdir(parents=True, exist_ok=True)
    cfg_path.write_text(json.dumps(data, indent=2, ensure_ascii=False), encoding="utf-8")
    try:
        os.chmod(cfg_path, 0o600)
    except Exception:
        pass
PYEOF
}

status_app() {
  if [ -f "$PID_FILE" ]; then
    local pid
    pid="$(head -n 1 "$PID_FILE" | tr -d '[:space:]')"
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      return 0
    fi
    rm -f "$PID_FILE"
  fi
  return 1
}

start_app() {
  if status_app; then
    return 0
  fi

  rotate_log
  ensure_venv || return 1
  sync_wizard_to_config

  log_msg "启动 ${APP_NAME}..."

  # 确保默认回退目录存在（config.py 会按 用户网页自定义目录 > TRIM_DATA_ACCESSIBLE_PATHS > TRIM_DATA_SHARE_PATHS 自动选取，
  # 这里不再注入 TGGET_DIR 或 --dir，避免重启后覆盖用户在网页设置中选择的保存目录）
  DEFAULT_SHARE="${TRIM_DATA_ACCESSIBLE_PATHS%%:*}"
  if [ -z "$DEFAULT_SHARE" ]; then
    DEFAULT_SHARE="${TRIM_DATA_SHARE_PATHS%%:*}"
    [ -n "$DEFAULT_SHARE" ] && DEFAULT_SHARE="${DEFAULT_SHARE}/downloads"
  fi
  if [ -z "$DEFAULT_SHARE" ]; then
    DEFAULT_SHARE="${DATA_DIR}/downloads"
  fi
  mkdir -p "${DEFAULT_SHARE}" "$DATA_DIR" 2>/dev/null || true

  cd "$APP_DIR" || return 1

  export TG_HOME="${DATA_DIR}"
  export TGGET_PORT="${TRIM_SERVICE_PORT:-64780}"

  # 若生命周期脚本以 root 运行，降权到专用包用户
  local RUN_PREFIX=""
  if [ "$(id -u)" = "0" ] && [ -n "$TRIM_USERNAME" ]; then
    chown -R "$TRIM_USERNAME" "$DATA_DIR" 2>/dev/null || true
    RUN_PREFIX="runuser -u $TRIM_USERNAME --"
  fi

  $RUN_PREFIX "${VENV_DIR}/bin/python" run.py serve \
    --no-browser \
    --host 0.0.0.0 \
    --port "${TRIM_SERVICE_PORT:-64780}" >> "$LOG_FILE" 2>&1 &

  local new_pid="$!"
  echo "$new_pid" > "$PID_FILE"

  # 启动后存活探测：等待 1 秒确认进程未因端口冲突或配置错误闪退
  sleep 1
  if ! status_app; then
    local last_err
    last_err="$(tail -n 5 "$LOG_FILE" 2>/dev/null | tr '\n' ' ')"
    report_err "服务启动后异常退出：${last_err:-请检查日志}"
    return 1
  fi

  log_msg "已启动，PID=${new_pid}，端口=${TRIM_SERVICE_PORT:-64780}，默认授权目录=${DEFAULT_SHARE}"
  return 0
}

stop_app() {
  log_msg "停止 ${APP_NAME}..."
  if [ ! -f "$PID_FILE" ]; then
    return 0
  fi
  local pid
  pid="$(head -n 1 "$PID_FILE" | tr -d '[:space:]')"
  if [ -z "$pid" ] || ! kill -0 "$pid" 2>/dev/null; then
    rm -f "$PID_FILE"
    return 0
  fi
  kill -TERM "$pid" 2>> "$LOG_FILE" || true
  local count=0
  while kill -0 "$pid" 2>/dev/null && [ "$count" -lt 10 ]; do
    sleep 1
    count=$((count + 1))
  done
  if kill -0 "$pid" 2>/dev/null; then
    kill -KILL "$pid" 2>> "$LOG_FILE" || true
  fi
  rm -f "$PID_FILE"
  return 0
}

case "$1" in
  start)
    start_app
    ;;
  stop)
    stop_app
    ;;
  status)
    if status_app; then
      exit 0
    fi
    exit 3
    ;;
  sync_deps)
    ensure_venv && sync_wizard_to_config
    ;;
  *)
    report_err "Unknown command: $1"
    exit 1
    ;;
esac
